# ============================================================
# AEGISAI — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git (it's in .gitignore).
# ============================================================

# --- Database (Supabase Postgres + pgvector, free tier) ---
# Get this from Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# --- LLM Provider (primary) ---
# Free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM Provider (local fallback, used if Groq is unavailable/rate-limited) ---
# Requires Ollama running locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Which provider to try first: "groq" or "ollama"
LLM_PRIMARY_PROVIDER=groq

# --- Embeddings (local, open-source, no external dependency) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Dedup / matching thresholds (tune during Day 1 seeding) ---
ENTITY_SIMILARITY_THRESHOLD=0.86
EVIDENCE_RELEVANCE_THRESHOLD=0.72
